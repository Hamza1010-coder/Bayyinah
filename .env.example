# Copy to .env and export, or set these in your shell / compose file.
# Everything is optional: with no configuration the app runs fully offline.

# --- storage ---
BAYYINAH_DB_PATH=var/bayyinah.db

# --- security ---
# Set this in production. Without it the API is unauthenticated (dev mode).
#   openssl rand -hex 24
BAYYINAH_API_KEY=
BAYYINAH_RATE_LIMIT=60
BAYYINAH_MAX_UPLOAD_BYTES=5242880

# --- generation ---
# Any OpenAI-compatible endpoint: OpenAI, vLLM, Ollama, TGI, or a self-hosted
# ALLaM server. Leave blank to use the offline extractive baseline.
# Keeping this in-Kingdom is the PDPL-friendly path.
BAYYINAH_LLM_BASE_URL=
BAYYINAH_LLM_MODEL=gpt-4o-mini
BAYYINAH_LLM_API_KEY=

# --- retrieval tuning (change with the eval open, not from memory) ---
BAYYINAH_MIN_EVIDENCE=0.25
BAYYINAH_MIN_TERM_IDF=0.85
BAYYINAH_TOP_K=5

# --- embeddings ---
BAYYINAH_EMBEDDER=hashing
